{% doc %}
  @prompt
    Create a Heritage footer block for a handloom textiles store with a fully functional expandable/collapsible accordion menu for mobile. The footer should include: navigation menu links that collapse into expandable sections on mobile (with a toggle arrow/icon that rotates when expanded), smooth expand/collapse animation using JavaScript click event listeners, proper CSS transitions for height animation, and full desktop layout showing all links without accordion behavior. The footer should match a premium heritage brand aesthetic with clean layout. Ensure the JavaScript properly handles click events on menu headings to toggle visibility of child links.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-heritage-footer-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};border-top:1px solid {{ block.settings.divider_color }}}.ai-heritage-footer-{{ ai_gen_id }}__inner{max-width:1200px;margin:0 auto;padding:{{ block.settings.vertical_padding }}px 24px}.ai-heritage-footer-{{ ai_gen_id }}__brand{max-width:420px;margin-bottom:42px}.ai-heritage-footer-{{ ai_gen_id }}__title{margin:0 0 12px;color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }};font-size:{{ block.settings.heading_size }}px;font-weight:500;letter-spacing:.04em;line-height:1.2}.ai-heritage-footer-{{ ai_gen_id }}__description{margin:0;color:{{ block.settings.muted_text_color }};font-size:15px;line-height:1.7}.ai-heritage-footer-{{ ai_gen_id }}__menus{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px}.ai-heritage-footer-{{ ai_gen_id }}__heading{display:flex;align-items:center;justify-content:space-between;width:100%;padding:0 0 14px;border:0;border-bottom:1px solid {{ block.settings.divider_color }};background:transparent;color:{{ block.settings.heading_color }};font:inherit;font-size:13px;font-weight:600;letter-spacing:.12em;text-align:left;text-transform:uppercase}.ai-heritage-footer-{{ ai_gen_id }}__icon{display:none;width:9px;height:9px;border-right:1px solid currentColor;border-bottom:1px solid currentColor;transform:rotate(45deg) translateY(-3px);transition:transform 220ms ease}.ai-heritage-footer-{{ ai_gen_id }}__heading[aria-expanded=true] .ai-heritage-footer-{{ ai_gen_id }}__icon{transform:rotate(225deg) translate(-2px,-2px)}.ai-heritage-footer-{{ ai_gen_id }}__links{display:block;padding-top:16px}.ai-heritage-footer-{{ ai_gen_id }}__links a{display:block;width:fit-content;margin:0 0 11px;color:{{ block.settings.text_color }};font-size:15px;line-height:1.4;text-decoration:none}.ai-heritage-footer-{{ ai_gen_id }}__links a:hover{color:{{ block.settings.accent_color }};text-decoration:underline;text-underline-offset:3px}.ai-heritage-footer-{{ ai_gen_id }}__bottom{display:flex;justify-content:space-between;gap:20px;margin-top:48px;padding-top:18px;border-top:1px solid {{ block.settings.divider_color }};color:{{ block.settings.muted_text_color }};font-size:12px}@media screen and (max-width:749px){.ai-heritage-footer-{{ ai_gen_id }}__inner{padding:{{ block.settings.mobile_padding }}px 20px}.ai-heritage-footer-{{ ai_gen_id }}__menus{display:block}.ai-heritage-footer-{{ ai_gen_id }}__menu{border-bottom:1px solid {{ block.settings.divider_color }}}.ai-heritage-footer-{{ ai_gen_id }}__heading{padding:18px 0;border-bottom:0;cursor:pointer}.ai-heritage-footer-{{ ai_gen_id }}__icon{display:block}.ai-heritage-footer-{{ ai_gen_id }}__links{max-height:0;overflow:hidden;padding-top:0;transition:max-height 260ms ease,padding 260ms ease}.ai-heritage-footer-{{ ai_gen_id }}__links.is-open{padding-bottom:8px}.ai-heritage-footer-{{ ai_gen_id }}__bottom{flex-direction:column;margin-top:30px}}{% endstyle %}
<heritage-footer-{{ ai_gen_id }} class="ai-heritage-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-heritage-footer-{{ ai_gen_id }}__inner"><div class="ai-heritage-footer-{{ ai_gen_id }}__brand"><h2 class="ai-heritage-footer-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h2>{{ block.settings.description }}</div><div class="ai-heritage-footer-{{ ai_gen_id }}__menus">{% for i in (1..3) %}{% assign heading_key = 'menu_' | append: i | append: '_heading' %}{% assign links_key = 'menu_' | append: i %}{% assign heading = block.settings[heading_key] %}{% assign menu = block.settings[links_key] %}<div class="ai-heritage-footer-{{ ai_gen_id }}__menu"><button class="ai-heritage-footer-{{ ai_gen_id }}__heading" type="button" aria-expanded="false" aria-controls="ai-heritage-links-{{ ai_gen_id }}-{{ i }}"><span>{{ heading | escape }}</span><span class="ai-heritage-footer-{{ ai_gen_id }}__icon" aria-hidden="true"></span></button><div id="ai-heritage-links-{{ ai_gen_id }}-{{ i }}" class="ai-heritage-footer-{{ ai_gen_id }}__links">{% if menu != blank %}{% for link in menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% endif %}</div></div>{% endfor %}</div><div class="ai-heritage-footer-{{ ai_gen_id }}__bottom"><span>{{ block.settings.copyright_text | escape }}</span><span>{{ shop.name | escape }}</span></div></div></heritage-footer-{{ ai_gen_id }}>
<script>(function(){class HeritageFooter{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.querySelectorAll('.ai-heritage-footer-{{ ai_gen_id }}__heading').forEach((heading)=>heading.addEventListener('click',()=>{if(window.matchMedia('(min-width: 750px)').matches)return;const links=this.querySelector('#'+heading.getAttribute('aria-controls'));const open=heading.getAttribute('aria-expanded')==='true';heading.setAttribute('aria-expanded',String(!open));links.style.maxHeight=open?'0px':links.scrollHeight+'px';links.classList.toggle('is-open',!open)}))}}if(!customElements.get('heritage-footer-{{ ai_gen_id }}'))customElements.define('heritage-footer-{{ ai_gen_id }}',HeritageFooter{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Heritage footer","tag":null,"class":"heritage-footer-block","settings":[{"type":"header","content":"Brand content"},{"type":"text","id":"title","label":"Title","default":"Woven with heritage"},{"type":"richtext","id":"description","label":"Description","default":"<p>Discover thoughtful handloom textiles rooted in India's weaving traditions.</p>"},{"type":"text","id":"copyright_text","label":"Copyright text","default":"Crafted with care"},{"type":"header","content":"Navigation"},{"type":"text","id":"menu_1_heading","label":"First heading","default":"Explore"},{"type":"link_list","id":"menu_1","label":"First menu"},{"type":"text","id":"menu_2_heading","label":"Second heading","default":"About"},{"type":"link_list","id":"menu_2","label":"Second menu"},{"type":"text","id":"menu_3_heading","label":"Third heading","default":"Support"},{"type":"link_list","id":"menu_3","label":"Third menu"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"vertical_padding","label":"Desktop padding","min":20,"max":100,"step":5,"unit":"px","default":55},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":16,"max":60,"step":4,"unit":"px","default":32},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#242833"},{"type":"color","id":"heading_color","label":"Headings","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#FFFFFF"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#D6D8DC"},{"type":"color","id":"divider_color","label":"Dividers","default":"#68707D"},{"type":"color","id":"accent_color","label":"Accent","default":"#F4D8A8"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"assistant_n4"},{"type":"range","id":"heading_size","label":"Heading size","min":18,"max":44,"step":2,"unit":"px","default":28}],"presets":[{"name":"Heritage footer"}]}{% endschema %}