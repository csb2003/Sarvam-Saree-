{% doc %}
  @prompt
    Create a custom footer section that matches the existing footer layout on desktop (multi-column with menus for Shop, Discover, and Help), but on mobile, each menu group should be collapsible/expandable with an accordion toggle (click the heading to expand or collapse the links below it). The footer should include: newsletter signup, social icons, payment icons, and policy links at the bottom. The desktop layout should show all menu columns side by side. The mobile layout should stack them vertically with each menu collapsed by default and expandable by tapping the heading. Style it to match a premium heritage textile brand with clean layout and minimal design., I need a space on it to upload the Logo at the Top Left of the Section. I should have the option to enlarge or reduce the logo size., Change the Social Media access on it from text to icons. Add option to add or remove all available major social media icons to it.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture form_class %}ai-footer-{{ ai_gen_id }}__form{% endcapture %}
{% style %}.ai-footer-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};border-top:1px solid {{ block.settings.divider_color }}}.ai-footer-{{ ai_gen_id }}__inner{max-width:{{ block.settings.content_width }}px;margin:0 auto;padding:32px 24px 22px}.ai-footer-{{ ai_gen_id }}__brand{margin-bottom:38px}.ai-footer-{{ ai_gen_id }}__logo{display:block;height:auto;width:{{ block.settings.logo_width }}px;max-width:100%}.ai-footer-{{ ai_gen_id }}__logo-placeholder{align-items:center;background:{{ block.settings.divider_color }};display:flex;height:60px;justify-content:center;width:{{ block.settings.logo_width }}px;max-width:100%}.ai-footer-{{ ai_gen_id }}__logo-placeholder svg{height:100%;width:100%}.ai-footer-{{ ai_gen_id }}__top{display:grid;grid-template-columns:minmax(220px,1.35fr) repeat(3,minmax(120px,1fr));gap:42px;padding-bottom:48px}.ai-footer-{{ ai_gen_id }}__newsletter-title,.ai-footer-{{ ai_gen_id }}__heading{color:{{ block.settings.heading_color }};font-size:14px;letter-spacing:.08em;line-height:1.4;margin:0 0 18px;text-transform:uppercase}.ai-footer-{{ ai_gen_id }}__copy{font-size:14px;line-height:1.6;margin:0 0 20px;max-width:310px}.ai-footer-{{ ai_gen_id }}__form{display:flex;border-bottom:1px solid {{ block.settings.text_color }};max-width:360px}.ai-footer-{{ ai_gen_id }}__input{background:transparent;border:0;color:{{ block.settings.text_color }};flex:1;font:inherit;min-width:0;outline:none;padding:12px 0}.ai-footer-{{ ai_gen_id }}__input::placeholder{color:{{ block.settings.text_color }};opacity:.7}.ai-footer-{{ ai_gen_id }}__submit{background:transparent;border:0;color:{{ block.settings.heading_color }};cursor:pointer;font:inherit;padding:12px 0 12px 12px}.ai-footer-{{ ai_gen_id }}__menu{min-width:0}.ai-footer-{{ ai_gen_id }}__toggle{background:none;border:0;color:inherit;padding:0;text-align:left;width:100%}.ai-footer-{{ ai_gen_id }}__chevron{display:none}.ai-footer-{{ ai_gen_id }}__links{list-style:none;margin:0;padding:0}.ai-footer-{{ ai_gen_id }}__links li{margin:0 0 11px}.ai-footer-{{ ai_gen_id }}__links a,.ai-footer-{{ ai_gen_id }}__policy a{color:inherit;font-size:14px;text-decoration:none}.ai-footer-{{ ai_gen_id }}__links a:hover,.ai-footer-{{ ai_gen_id }}__policy a:hover{text-decoration:underline;text-underline-offset:3px}.ai-footer-{{ ai_gen_id }}__bottom{align-items:center;border-top:1px solid {{ block.settings.divider_color }};display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between;padding-top:20px}.ai-footer-{{ ai_gen_id }}__social,.ai-footer-{{ ai_gen_id }}__payments,.ai-footer-{{ ai_gen_id }}__policy{align-items:center;display:flex;flex-wrap:wrap;gap:14px}.ai-footer-{{ ai_gen_id }}__social a{align-items:center;color:inherit;display:inline-flex;justify-content:center}.ai-footer-{{ ai_gen_id }}__social svg{fill:currentColor;height:20px;width:20px}.ai-footer-{{ ai_gen_id }}__social a:hover{opacity:.7}.ai-footer-{{ ai_gen_id }}__social-label{position:absolute;width:1px;height:1px;overflow:hidden}.ai-footer-{{ ai_gen_id }}__payments svg{height:24px;width:38px}.ai-footer-{{ ai_gen_id }}__copyright{font-size:12px;opacity:.75}@media screen and (max-width:749px){.ai-footer-{{ ai_gen_id }}__inner{padding:26px 20px 20px}.ai-footer-{{ ai_gen_id }}__brand{margin-bottom:30px}.ai-footer-{{ ai_gen_id }}__top{display:block;padding-bottom:26px}.ai-footer-{{ ai_gen_id }}__newsletter{margin-bottom:34px}.ai-footer-{{ ai_gen_id }}__menu{border-top:1px solid {{ block.settings.divider_color }}}.ai-footer-{{ ai_gen_id }}__toggle{align-items:center;cursor:pointer;display:flex;justify-content:space-between;padding:18px 0}.ai-footer-{{ ai_gen_id }}__heading{margin:0}.ai-footer-{{ ai_gen_id }}__chevron{display:block;font-size:20px;line-height:1}.ai-footer-{{ ai_gen_id }}__links{display:none;padding:0 0 14px}.ai-footer-{{ ai_gen_id }}__menu.is-open .ai-footer-{{ ai_gen_id }}__links{display:block}.ai-footer-{{ ai_gen_id }}__menu.is-open .ai-footer-{{ ai_gen_id }}__chevron{transform:rotate(45deg)}.ai-footer-{{ ai_gen_id }}__bottom{align-items:flex-start;flex-direction:column;gap:18px}}
{% endstyle %}<heritage-footer-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-footer-{{ ai_gen_id }}__inner"><div class="ai-footer-{{ ai_gen_id }}__brand">{% if block.settings.logo %}<img class="ai-footer-{{ ai_gen_id }}__logo" src="{{ block.settings.logo | image_url: width: 600 }}" alt="{{ block.settings.logo.alt | default: shop.name | escape }}" width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}">{% else %}<div class="ai-footer-{{ ai_gen_id }}__logo-placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-footer-{{ ai_gen_id }}__top"><div class="ai-footer-{{ ai_gen_id }}__newsletter"><h2 class="ai-footer-{{ ai_gen_id }}__newsletter-title">{{ block.settings.newsletter_heading }}</h2><p class="ai-footer-{{ ai_gen_id }}__copy">{{ block.settings.newsletter_text }}</p>{% form 'customer', class: form_class %}<input type="hidden" name="contact[tags]" value="newsletter"><label for="ai-footer-email-{{ ai_gen_id }}" style="position:absolute;width:1px;height:1px;overflow:hidden">Email address</label><input id="ai-footer-email-{{ ai_gen_id }}" class="ai-footer-{{ ai_gen_id }}__input" type="email" name="contact[email]" placeholder="{{ block.settings.email_placeholder }}" required><button class="ai-footer-{{ ai_gen_id }}__submit" type="submit" aria-label="Subscribe">→</button>{% endform %}</div>{% assign menu_keys = 'shop_menu,discover_menu,help_menu' | split: ',' %}{% assign menu_titles = 'Shop,Discover,Help' | split: ',' %}{% for menu_key in menu_keys %}{% assign menu = block.settings[menu_key] %}<div class="ai-footer-{{ ai_gen_id }}__menu"><button class="ai-footer-{{ ai_gen_id }}__toggle" type="button" aria-expanded="false"><span class="ai-footer-{{ ai_gen_id }}__heading">{{ menu_titles[forloop.index0] }}</span><span class="ai-footer-{{ ai_gen_id }}__chevron" aria-hidden="true">+</span></button><ul class="ai-footer-{{ ai_gen_id }}__links">{% if menu != blank %}{% for link in menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}{% endif %}</ul></div>{% endfor %}</div><div class="ai-footer-{{ ai_gen_id }}__bottom"><div class="ai-footer-{{ ai_gen_id }}__social">{% if block.settings.show_instagram and settings.social_instagram_link != blank %}<a href="{{ settings.social_instagram_link }}" aria-label="Instagram"><span class="ai-footer-{{ ai_gen_id }}__social-label">Instagram</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5A4.5 4.5 0 1 1 12 16.5 4.5 4.5 0 0 1 12 7.5Zm0 2A2.5 2.5 0 1 0 12 14.5 2.5 2.5 0 0 0 12 9.5ZM17.5 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg></a>{% endif %}{% if block.settings.show_facebook and settings.social_facebook_link != blank %}<a href="{{ settings.social_facebook_link }}" aria-label="Facebook"><span class="ai-footer-{{ ai_gen_id }}__social-label">Facebook</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.75l.4-3h-3.15V8.08c0-.87.24-1.46 1.5-1.46h1.8V3.94c-.31-.04-1.38-.14-2.6-.14-2.57 0-4.33 1.57-4.33 4.46V10H7v3h2.87v8h3.63Z"/></svg></a>{% endif %}{% if block.settings.show_youtube and settings.social_youtube_link != blank %}<a href="{{ settings.social_youtube_link }}" aria-label="YouTube"><span class="ai-footer-{{ ai_gen_id }}__social-label">YouTube</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23 7.1a3 3 0 0 0-2.1-2.1C19.1 4.5 12 4.5 12 4.5s-7.1 0-8.9.5A3 3 0 0 0 1 7.1 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.9a3 3 0 0 0 2.1 2.1c1.8.5 8.9.5 8.9.5s7.1 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.9 31 31 0 0 0-.5-4.9ZM9.5 15.5v-7l6 3.5-6 3.5Z"/></svg></a>{% endif %}{% if block.settings.show_tiktok and settings.social_tiktok_link != blank %}<a href="{{ settings.social_tiktok_link }}" aria-label="TikTok"><span class="ai-footer-{{ ai_gen_id }}__social-label">TikTok</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h3c.2 1.7 1.2 3 3 3.5v3.1a7.8 7.8 0 0 1-3-.8v6.1a5.9 5.9 0 1 1-5.9-5.9c.3 0 .6 0 .9.1v3.1a2.8 2.8 0 1 0 1.9 2.7V3Z"/></svg></a>{% endif %}{% if block.settings.show_pinterest and settings.social_pinterest_link != blank %}<a href="{{ settings.social_pinterest_link }}" aria-label="Pinterest"><span class="ai-footer-{{ ai_gen_id }}__social-label">Pinterest</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-1.6 0-3.5.4-5.1l1.1-4.7s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.7 1.3 1.5 0 .9-.6 2.1-.9 3.3-.3 1 .5 1.8 1.5 1.8 1.8 0 3-1.9 3-4.7 0-2.5-1.8-4.2-4.4-4.2-3 0-4.8 2.2-4.8 4.5 0 .9.3 1.9.8 2.4.1.1.1.2.1.4l-.3 1.2c-.1.4-.4.5-.7.3-1.3-.6-2.1-2.5-2.1-4.1 0-3.3 2.4-6.4 7-6.4 3.7 0 6.5 2.6 6.5 6.1 0 3.6-2.3 6.6-5.5 6.6-1.1 0-2.1-.6-2.5-1.3l-.7 2.5c-.3 1.1-1 2.4-1.5 3.2A10 10 0 1 0 12 2Z"/></svg></a>{% endif %}</div><div class="ai-footer-{{ ai_gen_id }}__payments">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div><div class="ai-footer-{{ ai_gen_id }}__policy">{% if shop.privacy_policy %}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{% endif %}{% if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">Refunds</a>{% endif %}{% if shop.terms_of_service %}<a href="{{ shop.terms_of_service.url }}">Terms</a>{% endif %}<span class="ai-footer-{{ ai_gen_id }}__copyright">© {{ 'now' | date: '%Y' }} {{ shop.name }}</span></div></div></div></heritage-footer-{{ ai_gen_id }}><script>
(function(){
  var id = '{{ ai_gen_id }}';
  var selector = '.ai-footer-' + id + '__toggle';
  var menuClass = 'ai-footer-' + id + '__menu';
  var openClass = 'is-open';
  
  function initFooter(root) {
    root.querySelectorAll(selector).forEach(function(toggle) {
      toggle.addEventListener('click', function() {
        var menu = toggle.closest('.' + menuClass);
        var open = menu.classList.toggle(openClass);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { initFooter(document); });
  } else {
    initFooter(document);
  }
})();
</script>
{% schema %}{"name":"Heritage footer","tag":null,"class":"heritage-footer-block","settings":[{"type":"header","content":"Brand logo"},{"type":"image_picker","id":"logo","label":"Logo"},{"type":"range","id":"logo_width","label":"Logo width","min":50,"max":400,"step":10,"unit":"px","default":190},{"type":"header","content":"Menus"},{"type":"link_list","id":"shop_menu","label":"Shop menu"},{"type":"link_list","id":"discover_menu","label":"Discover menu"},{"type":"link_list","id":"help_menu","label":"Help menu"},{"type":"header","content":"Newsletter"},{"type":"text","id":"newsletter_heading","label":"Heading","default":"Stay connected"},{"type":"textarea","id":"newsletter_text","label":"Description","default":"Stories, new collections, and thoughtful notes from our weaving community."},{"type":"text","id":"email_placeholder","label":"Email placeholder","default":"Your email address"},{"type":"header","content":"Social icons"},{"type":"checkbox","id":"show_instagram","label":"Show Instagram","default":true},{"type":"checkbox","id":"show_facebook","label":"Show Facebook","default":true},{"type":"checkbox","id":"show_youtube","label":"Show YouTube","default":true},{"type":"checkbox","id":"show_tiktok","label":"Show TikTok","default":true},{"type":"checkbox","id":"show_pinterest","label":"Show Pinterest","default":true},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1600,"step":100,"unit":"px","default":1200},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#242833"},{"type":"color","id":"text_color","label":"Text","default":"#FFFFFF"},{"type":"color","id":"heading_color","label":"Headings","default":"#FFFFFF"},{"type":"color","id":"divider_color","label":"Dividers","default":"#667080"}],"presets":[{"name":"Heritage footer"}]}{% endschema %}