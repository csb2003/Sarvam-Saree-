{% doc %}
  @prompt
    Add a sticky Add to Cart button for the product page. The button should stick to the bottom of the screen as the user scrolls, appearing only after the main Add to Cart button scrolls out of view. Display the product title and price alongside the button. Style it clean, minimal, and premium. Full-width sticky bar with smooth slide-up animation on scroll. IMPORTANT FIXES: 1) Do NOT use a Liquid product form tag — use JavaScript fetch to /cart/add.js to add to cart. 2) For the sold-out/available state, do NOT rely on Liquid availability checks. Instead, use JavaScript to read the availability dynamically: listen to the 'variant:change' or 'change' events on the variant selector, or read the selected variant ID from the existing product form on the page and check availability via the Shopify product JSON endpoint (product.js or variants). This ensures the button correctly shows Add to Cart (not Sold Out) when the selected variant is available, and only shows Sold Out when that specific variant is actually unavailable. Default the button to available/active state on page load unless the variant is truly sold out.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sticky-atc-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-sticky-atc-{{ ai_gen_id }}__bar {
    position: fixed;
    z-index: 50;
    right: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 12px 20px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-top: 1px solid {{ block.settings.border_color }};
    box-shadow: 0 -8px 24px rgba(18, 18, 18, 0.08);
    transform: translateY(110%);
    visibility: hidden;
    transition: transform 0.28s ease, visibility 0.28s ease;
  }

  .ai-sticky-atc-{{ ai_gen_id }}__bar.is-visible {
    transform: translateY(0);
    visibility: visible;
  }

  .ai-sticky-atc-{{ ai_gen_id }}__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-sticky-atc-{{ ai_gen_id }}__details {
    min-width: 0;
  }

  .ai-sticky-atc-{{ ai_gen_id }}__title {
    margin: 0 0 3px;
    overflow: hidden;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-sticky-atc-{{ ai_gen_id }}__price {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.3;
  }

  .ai-sticky-atc-{{ ai_gen_id }}__button {
    flex: 0 0 auto;
    min-width: 170px;
    padding: 13px 24px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
  }

  .ai-sticky-atc-{{ ai_gen_id }}__button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .ai-sticky-atc-{{ ai_gen_id }}__button:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-sticky-atc-{{ ai_gen_id }}__bar {
      padding: 10px 14px;
    }

    .ai-sticky-atc-{{ ai_gen_id }}__inner {
      gap: 12px;
    }

    .ai-sticky-atc-{{ ai_gen_id }}__title {
      font-size: 14px;
    }

    .ai-sticky-atc-{{ ai_gen_id }}__price {
      font-size: 13px;
    }

    .ai-sticky-atc-{{ ai_gen_id }}__button {
      min-width: 132px;
      padding: 12px 14px;
      font-size: 13px;
    }
  }
{% endstyle %}

<sticky-add-to-cart-{{ ai_gen_id }}
  class="ai-sticky-atc-{{ ai_gen_id }}"
  data-product-handle="{{ product.handle | escape }}"
  data-product-id="{{ product.id }}"
  data-initial-variant-id="{{ product.selected_or_first_available_variant.id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-sticky-atc-{{ ai_gen_id }}__bar" data-sticky-bar aria-hidden="true">
    <div class="ai-sticky-atc-{{ ai_gen_id }}__inner">
      <div class="ai-sticky-atc-{{ ai_gen_id }}__details">
        <p class="ai-sticky-atc-{{ ai_gen_id }}__title">{{ product.title | escape }}</p>
        <span class="ai-sticky-atc-{{ ai_gen_id }}__price" data-price>{{ product.selected_or_first_available_variant.price | money }}</span>
      </div>
      <button class="ai-sticky-atc-{{ ai_gen_id }}__button" type="button" data-add-button>{{ block.settings.button_label }}</button>
    </div>
  </div>
</sticky-add-to-cart-{{ ai_gen_id }}>

<script>
  (() => {
    class StickyAddToCart{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.bar = this.querySelector('[data-sticky-bar]');
        this.button = this.querySelector('[data-add-button]');
        this.price = this.querySelector('[data-price]');
        this.product = null;
        this.variant = null;
        this.mainForm = this.findProductForm();
        this.observeMainButton();
        this.loadProduct();
        document.addEventListener('variant:change', this.handleVariantEvent.bind(this));
        document.addEventListener('change', this.handleChange.bind(this));
        this.button.addEventListener('click', this.addToCart.bind(this));
      }

      findProductForm() {
        return document.querySelector('form[action*="/cart/add"]');
      }

      observeMainButton() {
        const mainButton = this.mainForm && this.mainForm.querySelector('[type="submit"]');
        if (!mainButton) return;
        const observer = new IntersectionObserver((entries) => {
          const visible = entries[0].isIntersecting;
          this.bar.classList.toggle('is-visible', !visible);
          this.bar.setAttribute('aria-hidden', visible ? 'true' : 'false');
        }, { threshold: 0.1 });
        observer.observe(mainButton);
      }

      async loadProduct() {
        try {
          const response = await fetch('/products/{{ product.handle }}.js');
          this.product = await response.json();
          this.updateVariant(this.getVariantId());
        } catch (error) {
          this.updateVariant(this.getVariantId());
        }
      }

      getVariantId() {
        const input = this.mainForm && this.mainForm.querySelector('[name="id"]');
        return input ? input.value : null;
      }

      handleVariantEvent(event) {
        const variant = event.detail && (event.detail.variant || event.detail);
        if (variant && variant.id) this.updateVariant(String(variant.id), variant);
      }

      handleChange(event) {
        if (!event.target.closest('form[action*="/cart/add"]')) return;
        window.setTimeout(() => this.updateVariant(this.getVariantId()), 0);
      }

      updateVariant(id, suppliedVariant) {
        if (!id) return;
        let variant = suppliedVariant;
        if (!variant && this.product && this.product.variants) {
          variant = this.product.variants.find((item) => String(item.id) === String(id));
        }
        this.variant = variant || { id: id, available: true };
        if (variant && variant.price) this.price.textContent = this.formatMoney(variant.price);
        const available = this.variant.available !== false;
        this.button.disabled = !available;
        this.button.textContent = available ? '{{ block.settings.button_label | escape }}' : '{{ block.settings.sold_out_label | escape }}';
      }

      formatMoney(cents) {
        return new Intl.NumberFormat('{{ localization.language.iso_code }}-IN', { style: 'currency', currency: '{{ shop.currency }}' }).format(cents / 100);
      }

      async addToCart() {
        const id = this.getVariantId() || (this.variant && this.variant.id);
        if (!id || this.button.disabled) return;
        this.button.disabled = true;
        const originalLabel = this.button.textContent;
        this.button.textContent = '{{ block.settings.loading_label | escape }}';
        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: [{ id: Number(id), quantity: 1 }] })
          });
          if (!response.ok) throw new Error('Add to cart failed');
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          window.location.href = '{{ routes.cart_url }}';
        } catch (error) {
          this.button.disabled = false;
          this.button.textContent = originalLabel;
        }
      }
    }

    customElements.define('sticky-add-to-cart-{{ ai_gen_id }}', StickyAddToCart{{ ai_gen_id }});
  })();
</script>

