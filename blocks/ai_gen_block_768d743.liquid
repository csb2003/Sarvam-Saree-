{% doc %}
  @prompt
    Add fluid, responsive typography across all mobile devices (360px to 430px screen widths including iPhone SE, iPhone 16, iPhone 16 Pro Max, Pixel 9, Pixel 10, Samsung Galaxy A55). The product title (saree name) on product pages should scale fluidly using CSS clamp() so it never wraps awkwardly, overflows, or appears too large or too small on any device. Also apply fluid font sizing to other key text elements: product price, section headings, collection titles, and body text. Use viewport-relative units and clamp() for smooth scaling. Ensure line-height and letter-spacing also adapt proportionally. No text should overflow its container or require horizontal scrolling on any of the listed devices.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fluid-type-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  :root {
    --ai-fluid-title-size-{{ ai_gen_id }}: clamp({{ block.settings.title_min }}px, {{ block.settings.title_viewport }}vw, {{ block.settings.title_max }}px);
    --ai-fluid-price-size-{{ ai_gen_id }}: clamp({{ block.settings.price_min }}px, {{ block.settings.price_viewport }}vw, {{ block.settings.price_max }}px);
    --ai-fluid-heading-size-{{ ai_gen_id }}: clamp({{ block.settings.heading_min }}px, {{ block.settings.heading_viewport }}vw, {{ block.settings.heading_max }}px);
    --ai-fluid-body-size-{{ ai_gen_id }}: clamp({{ block.settings.body_min }}px, {{ block.settings.body_viewport }}vw, {{ block.settings.body_max }}px);
  }

  .product__title h1,
  .product__title h2,
  .product__title .h1,
  .product__title .h2 {
    font-size: var(--ai-fluid-title-size-{{ ai_gen_id }});
    line-height: {{ block.settings.title_line_height }};
    letter-spacing: {{ block.settings.title_letter_spacing }}em;
    overflow-wrap: anywhere;
    word-break: normal;
    max-width: 100%;
  }

  .price,
  .price-item,
  .product__info-container .price,
  .card-information .price {
    font-size: var(--ai-fluid-price-size-{{ ai_gen_id }});
    line-height: {{ block.settings.price_line_height }};
    letter-spacing: {{ block.settings.price_letter_spacing }}em;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  h1:not(.product__title h1),
  h2,
  h3,
  h4,
  .title,
  .collection-hero__title,
  .collection-list-title,
  .section-header__title {
    font-size: var(--ai-fluid-heading-size-{{ ai_gen_id }});
    line-height: {{ block.settings.heading_line_height }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}em;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  p,
  li,
  label,
  input,
  select,
  textarea,
  button,
  .rte,
  .caption,
  .product-card__title,
  .card__heading,
  .collection-card__title {
    font-size: var(--ai-fluid-body-size-{{ ai_gen_id }});
    line-height: {{ block.settings.body_line_height }};
    letter-spacing: {{ block.settings.body_letter_spacing }}em;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  .product__title,
  .product__info-container,
  .card__content,
  .card-information,
  .collection-card-wrapper,
  .collection-hero__text-container {
    min-width: 0;
    max-width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-fluid-type-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<fluid-typography-{{ ai_gen_id }} class="ai-fluid-type-{{ ai_gen_id }}" {{ block.shopify_attributes }} aria-hidden="true"></fluid-typography-{{ ai_gen_id }}>

