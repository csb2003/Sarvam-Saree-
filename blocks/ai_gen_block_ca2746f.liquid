{% doc %}
  @prompt
    Create a variant-aware image gallery filter for the product page. When a customer selects a color variant (e.g., "Crimson Pink", "Bronze Black", "Green Copper", "Plum"), the media gallery should filter to show only images belonging to that color. The filtering should be based on image alt text or filename matching the selected variant's color option value. All images should show by default. On variant change (via swatch or dropdown), smoothly hide non-matching images and show only the relevant color's images. The solution should work with Shopify's native variant picker and media gallery, and be compatible with a standard Dawn-based theme.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-variant-gallery-filter-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .ai-variant-gallery-filter-{{ ai_gen_id }} [data-ai-gallery-hidden="true"] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    max-height: 0;
    overflow: hidden;
  }

  .ai-variant-gallery-filter-{{ ai_gen_id }} [data-ai-gallery-filter-item] {
    transition: opacity 180ms ease, visibility 180ms ease, max-height 180ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-variant-gallery-filter-{{ ai_gen_id }} [data-ai-gallery-filter-item] {
      transition: none;
    }
  }
{% endstyle %}

<variant-gallery-filter-{{ ai_gen_id }}
  class="ai-variant-gallery-filter-{{ ai_gen_id }}"
  data-option-index="{{ block.settings.color_option_index }}"
  {{ block.shopify_attributes }}
></variant-gallery-filter-{{ ai_gen_id }}>

<script>
  (function() {
    if (customElements.get('variant-gallery-filter-{{ ai_gen_id }}')) return;

    class VariantGalleryFilter{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.optionIndex = Math.max(0, Number(this.dataset.optionIndex || 1) - 1);
        this.section = this.closest('.shopify-section');
        this.productRoot = this.section || document;
        this.bindEvents();
        this.filterFromCurrentVariant();
      }

      bindEvents() {
        this.productRoot.addEventListener('change', (event) => {
          if (event.target.matches('select[name="id"], select[name^="options["], input[name^="options["]')) {
            window.requestAnimationFrame(() => this.filterFromCurrentVariant());
          }
        });

        this.productRoot.addEventListener('variant:change', (event) => {
          const variant = event.detail && (event.detail.variant || event.detail);
          const value = variant && variant.options ? variant.options[this.optionIndex] : this.readOptionValue();
          this.applyFilter(value);
        });

        document.addEventListener('shopify:section:load', () => {
          this.section = this.closest('.shopify-section');
          this.productRoot = this.section || document;
          this.filterFromCurrentVariant();
        });
      }

      readOptionValue() {
        const optionInputs = this.productRoot.querySelectorAll('select[name^="options["], input[name^="options["]');
        const values = [];
        optionInputs.forEach((input) => {
          if (input.type === 'radio' && !input.checked) return;
          if (input.value) values.push(input.value);
        });
        return values[this.optionIndex] || '';
      }

      filterFromCurrentVariant() {
        const variantId = this.productRoot.querySelector('select[name="id"]')?.value;
        const variant = window.Shopify && Shopify.routes ? null : null;
        const optionValue = this.readOptionValue();
        if (optionValue) {
          this.applyFilter(optionValue);
          return;
        }
        if (variantId) this.applyFilter('');
      }

      normalize(value) {
        return String(value || '')
          .toLowerCase()
          .replace(/%20/g, ' ')
          .replace(/[_-]+/g, ' ')
          .replace(/[^a-z0-9]+/g, ' ')
          .trim()
          .replace(/\s+/g, ' ');
      }

      applyFilter(optionValue) {
        const selected = this.normalize(optionValue);
        const items = this.productRoot.querySelectorAll('[data-media-id], .product__media-item, .thumbnail-list__item');
        if (!items.length || !selected) {
          items.forEach((item) => {
            item.removeAttribute('data-ai-gallery-hidden');
            item.removeAttribute('aria-hidden');
          });
          return;
        }

        const selectedParts = selected.split(' ').filter((part) => part.length > 2);
        let matches = 0;
        const uniqueItems = Array.from(new Set(items));

        uniqueItems.forEach((item) => {
          const media = item.querySelector('img, video, model-viewer') || item;
          const text = this.normalize([
            media.getAttribute('alt'),
            media.getAttribute('src'),
            media.getAttribute('data-src'),
            media.getAttribute('data-media-id'),
            item.getAttribute('data-media-id')
          ].join(' '));
          const isMatch = text.includes(selected) || (selectedParts.length > 0 && selectedParts.every((part) => text.includes(part)));
          if (isMatch) matches += 1;
          item.dataset.aiGalleryFilterItem = 'true';
          item.dataset.aiGalleryHidden = isMatch ? 'false' : 'true';
          item.setAttribute('aria-hidden', isMatch ? 'false' : 'true');
        });

        if (!matches) {
          uniqueItems.forEach((item) => {
            item.removeAttribute('data-ai-gallery-hidden');
            item.removeAttribute('aria-hidden');
          });
        }
      }
    }

    customElements.define('variant-gallery-filter-{{ ai_gen_id }}', VariantGalleryFilter{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Variant gallery filter",
  "settings": [
    {
      "type": "header",
      "content": "Filter behavior"
    },
    {
      "type": "range",
      "id": "color_option_index",
      "label": "Color option position",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "paragraph",
      "content": "Images are matched against their alt text and filename. Leave images unmatched to show the complete gallery."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Variant gallery filter"
    }
  ],
  "tag": null,
  "class": "variant-gallery-filter-block"
}
{% endschema %}